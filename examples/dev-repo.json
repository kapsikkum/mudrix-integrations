{
  "schema": 1,
  "name": "Mudrix dev examples",
  "integrations": [
    {
      "id": "dev-example",
      "name": "Dev example",
      "description": "For local testing only: exercises link cards, a composer action, commands, an api action and a widget against examples/dev-server.mjs. Do not publish.",
      "version": "0.0.1",
      "permissions": {
        "linkCards": [
          {
            "hosts": ["dev-links.example"],
            "title": "Dev example link (local testing only)",
            "subtitle": "For local testing",
            "buttonLabel": "Open"
          }
        ],
        "composerActions": [
          {
            "id": "dev-link",
            "label": "Dev link",
            "icon": "link",
            "insert": "https://dev-links.example/room?id={room}"
          }
        ],
        "commands": [
          {
            "name": "push",
            "description": "Dev only: push a note to the local mock API",
            "usage": "/push <note>",
            "api": "push"
          },
          {
            "name": "hello",
            "description": "Dev only: open the local hello widget",
            "widget": true
          }
        ],
        "api": {
          "host": "localhost:8787",
          "actions": [
            {
              "id": "push",
              "label": "Push note",
              "path": "/v1/push",
              "body": { "room": "{room}", "text": "{text}" }
            }
          ]
        },
        "widget": {
          "url": "http://localhost:8788/",
          "name": "Hello widget (dev)",
          "capabilities": ["send.message", "read.room"],
          "parameters": ["room_id"]
        }
      }
    },
    {
      "id": "dev-file-share",
      "name": "File share (dev)",
      "description": "For local testing only: a widget that uploads a file, sends it as an m.file message and announces it with a custom event. Served by examples/dev-server.mjs. Do not publish.",
      "version": "0.1.0",
      "permissions": {
        "commands": [
          {
            "name": "share",
            "description": "Send a file",
            "usage": "/share",
            "widget": true
          }
        ],
        "widget": {
          "url": "http://localhost:8788/file-share/",
          "name": "File share",
          "capabilities": ["send.message", "upload.file"],
          "parameters": ["room_id"],
          "events": ["com.example.fileshare.sent"]
        }
      }
    },
    {
      "id": "dev-viewer",
      "name": "Link viewer (dev)",
      "description": "For local testing only: cards for links on app.altersend.com get a button that opens the page in a window, which may save files. Do not publish.",
      "version": "0.1.0",
      "permissions": {
        "linkCards": [
          {
            "hosts": ["app.altersend.com"],
            "pathPrefix": "/r",
            "title": "AlterSend transfer",
            "subtitle": "Sent straight from the sender's device, end-to-end encrypted",
            "buttonLabel": "Open in browser"
          }
        ],
        "widget": {
          "url": "https://app.altersend.com/",
          "name": "AlterSend",
          "capabilities": [],
          "fromLinks": true,
          "linkLabel": "Download",
          "saveFiles": true
        }
      }
    },
    {
      "id": "dev-details",
      "name": "Link details (dev)",
      "description": "For local testing only: links such as https://dev-repos.example/octo/hello get a card whose details come from the local dev server's GET /v1/details/octo/hello. A name of 'missing' answers 404. Do not publish.",
      "version": "0.1.0",
      "settings": [
        { "id": "showDescription", "label": "Show the description", "type": "toggle", "default": true },
        { "id": "showStars", "label": "Show stars", "type": "toggle", "default": true },
        { "id": "showLanguage", "label": "Show the language", "type": "toggle", "default": true },
        { "id": "label", "label": "Card label", "type": "text", "default": "Sample project (dev)", "maxLength": 40 },
        {
          "id": "size",
          "label": "Title style",
          "type": "choice",
          "default": "full",
          "options": [
            { "value": "full", "label": "owner/name" },
            { "value": "short", "label": "name only" }
          ]
        }
      ],
      "permissions": {
        "linkCards": [
          {
            "hosts": ["dev-repos.example"],
            "pathPattern": "/{owner}/{name}",
            "pathExclude": ["/orgs", "/settings"],
            "title": "{owner}/{name}",
            "subtitle": "{setting.label} · {setting.size}",
            "buttonLabel": "Open",
            "details": "project"
          }
        ],
        "linkDetails": {
          "host": "localhost:8787",
          "lookups": [
            {
              "id": "project",
              "path": "/v1/details/{owner}/{name}",
              "title": "full_name",
              "description": "description",
              "descriptionIf": "showDescription",
              "facts": [
                { "label": "Stars", "field": "stargazers_count", "format": "count", "if": "showStars" },
                { "label": "Language", "field": "language", "if": "showLanguage" },
                { "label": "Updated", "field": "pushed_at", "format": "date" }
              ]
            }
          ]
        }
      }
    }
  ]
}
