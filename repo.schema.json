{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mudrix integrations repository (schema 1)",
  "description": "A structural check for editors and CI. Mudrix itself is the final validator: it also rejects invisible characters, duplicate ids and a few other things this schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "integrations"],
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "integrations": {
      "type": "array",
      "maxItems": 50,
      "items": { "$ref": "#/definitions/integration" }
    }
  },
  "definitions": {
    "httpsUrl": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https://[^/?#@\\s]+([/?#]\\S*)?$"
    },
    "host": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
      "not": { "pattern": "^[0-9.]+$" }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "version", "permissions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "version": { "type": "string", "minLength": 1, "maxLength": 20 },
        "icon": { "$ref": "#/definitions/httpsUrl" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkCards": {
              "type": "array",
              "maxItems": 10,
              "items": { "$ref": "#/definitions/linkCard" }
            },
            "composerActions": {
              "type": "array",
              "maxItems": 6,
              "items": { "$ref": "#/definitions/composerAction" }
            }
          }
        }
      }
    },
    "linkCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts", "title"],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/host" }
        },
        "pathPrefix": { "type": "string", "maxLength": 200, "pattern": "^/[^?#\\s\\\\]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 120 },
        "buttonLabel": { "type": "string", "minLength": 1, "maxLength": 24 },
        "icon": { "$ref": "#/definitions/httpsUrl" }
      }
    },
    "composerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "insert"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "icon": { "enum": ["send", "download", "link", "plus"] },
        "insert": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^([^{}]|\\{room\\})*$"
        }
      }
    }
  }
}
