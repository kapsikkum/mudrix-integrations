{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mudrix integrations repository (schema 1)",
  "description": "For editors (autocompletion and hints while you type). It is written to match Mudrix's validator but cannot express everything (cross-references such as a command's api target or a card's details lookup, unique ids, lengths in UTF-16 units). The real check is `node scripts/validate.mjs` (npm run check), which runs Mudrix's own validator; `npm run sign` runs it too. localhost hosts are accepted only by Mudrix development builds and are not valid here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "key",
    "serial",
    "integrations"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "name": {
      "allOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "maxLength": 60
        }
      ]
    },
    "key": {
      "description": "The repository's Ed25519 public key: standard base64 of the 32 raw bytes (44 characters). repo.json.sig must be a signature of the exact bytes of this file made with the matching private key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "serial": {
      "description": "Raise by one with every published change; Mudrix refuses a lower number than it has already seen.",
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "integrations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/integration"
      }
    }
  },
  "definitions": {
    "text": {
      "description": "Plain text: no control characters and no invisible or bidi formatting characters.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF\\uFFF9-\\uFFFB]*$"
    },
    "httpsUrl": {
      "description": "https, no user name or password, at most 500 characters.",
      "allOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "maxLength": 500,
          "pattern": "^https://[^/?#@\\s]+([/?#]\\S*)?$"
        }
      ]
    },
    "host": {
      "description": "An exact lowercase host name with at least two labels. No wildcards, ports or IP addresses.",
      "type": "string",
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)+$",
      "not": {
        "pattern": "^[0-9.]+$"
      }
    },
    "templateRoom": {
      "description": "Text whose only braces are complete {room} placeholders, or {setting.<id>} for a text or choice setting.",
      "allOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "maxLength": 500,
          "pattern": "^([^{}]|\\{room\\}|\\{setting\\.[a-zA-Z0-9]+\\})*$"
        }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "version",
        "permissions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 40
            }
          ]
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 400
            }
          ]
        },
        "version": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 20
            }
          ]
        },
        "icon": {
          "$ref": "#/definitions/httpsUrl"
        },
        "settings": {
          "description": "Up to 8 options the person can set. See definitions.setting.",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/definitions/setting"
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkCards": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/definitions/linkCard"
              }
            },
            "linkDetails": {
              "$ref": "#/definitions/linkDetails"
            },
            "composerActions": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "$ref": "#/definitions/composerAction"
              }
            },
            "commands": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "$ref": "#/definitions/command"
              }
            },
            "api": {
              "$ref": "#/definitions/api"
            },
            "widget": {
              "$ref": "#/definitions/widget"
            }
          }
        }
      }
    },
    "linkCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "title"
      ],
      "properties": {
        "hosts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/host"
          }
        },
        "pathPrefix": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^/[^?#\\s\\\\]*$",
          "description": "The link's path must start with this (a plain text prefix). Exclusive with pathPattern."
        },
        "pathPattern": {
          "description": "Segment pattern such as \"/{owner}/{repo}\": literal segments must match exactly, each {name} takes one whole segment, and the link may continue below. The captures can be used as {name} in title and subtitle and in a linkDetails lookup path. Exclusive with pathPrefix.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^(/(\\{[a-z][a-z0-9_]{0,15}\\}|[A-Za-z0-9._~-]+)){1,8}$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "pathExclude": {
          "description": "Paths this rule never matches, compared case-insensitively by whole segments: \"/orgs\" leaves out /orgs and /orgs/x but not /orgsx. Use it to keep a pattern such as \"/{owner}/{repo}\" off a site's own pages.",
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^/[^?#\\s\\\\{}]+$"
          }
        },
        "title": {
          "description": "Card title. May use {name} captures from pathPattern and {setting.<id>} for a text or choice setting.",
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 120
            }
          ]
        },
        "subtitle": {
          "description": "Line under the title. May use {name} captures from pathPattern and {setting.<id>} for a text or choice setting.",
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 120
            }
          ]
        },
        "buttonLabel": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 24
            }
          ]
        },
        "icon": {
          "description": "Accepted for compatibility but not shown: the card shows the integration's icon.",
          "$ref": "#/definitions/httpsUrl"
        },
        "details": {
          "description": "Id of a lookup in permissions.linkDetails.lookups. Needs pathPattern, and the pattern must capture every {name} the lookup path uses.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        }
      },
      "not": {
        "required": [
          "pathPrefix",
          "pathPattern"
        ]
      },
      "dependencies": {
        "details": [
          "pathPattern"
        ]
      }
    },
    "composerAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "insert"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "label": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 24
            }
          ]
        },
        "icon": {
          "enum": [
            "send",
            "download",
            "link",
            "plus"
          ]
        },
        "insert": {
          "$ref": "#/definitions/templateRoom"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,23}$"
        },
        "description": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 80
            }
          ]
        },
        "usage": {
          "description": "Must be \"/<name>\" or start with \"/<name> \" (checked by validate.yml).",
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 60,
              "pattern": "^/[a-z][a-z0-9-]{1,23}( .*)?$"
            }
          ]
        },
        "insert": {
          "description": "Text put into the message box. Placeholders: {room}, {args} and {setting.<id>} (a text or choice setting).",
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 500,
              "pattern": "^([^{}]|\\{room\\}|\\{args\\}|\\{setting\\.[a-zA-Z0-9]+\\})*$"
            }
          ]
        },
        "api": {
          "description": "Id of an action in permissions.api.actions (checked by validate.yml).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "widget": {
          "description": "Opens this integration's widget. Needs permissions.widget (checked by validate.yml).",
          "const": true
        }
      },
      "oneOf": [
        {
          "required": [
            "insert"
          ]
        },
        {
          "required": [
            "api"
          ]
        },
        {
          "required": [
            "widget"
          ]
        }
      ]
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "actions"
      ],
      "properties": {
        "host": {
          "$ref": "#/definitions/host"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/apiAction"
          }
        }
      }
    },
    "apiAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "label": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 24
            }
          ]
        },
        "path": {
          "description": "Starts with \"/\"; letters, digits and . _ ~ / - only; no \".\" or \"..\" segments.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^/[A-Za-z0-9._~/-]*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "body": {
          "description": "JSON body template. String values only; {room}, {text} and {args} are substituted, and {setting.<id>} for a choice setting (never a text setting: free text is not sent to hosts).",
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "not": {
              "const": "__proto__"
            }
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 200,
            "allOf": [
              {
                "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF\\uFFF9-\\uFFFB]*$"
              },
              {
                "pattern": "^([^{}]|\\{room\\}|\\{text\\}|\\{args\\}|\\{setting\\.[a-zA-Z0-9]+\\})*$"
              }
            ]
          }
        },
        "insertResultLink": {
          "description": "Name of a string field in the JSON response that holds a link to insert into the message box.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_]{1,32}$"
        }
      }
    },
    "widget": {
      "description": "RUNS CODE from the author's server in a sandboxed iframe. https only, no fragment, no \"$\", no theme or lang parameter, host with at least two labels (no IP address); a port is allowed. Must not be on Mudrix's own origin (checked by Mudrix).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "capabilities"
      ],
      "properties": {
        "url": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 500,
              "pattern": "^https://[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+(:[0-9]{1,5})?([/?][^#$\\s]*)?$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "^https://[0-9.]+(:[0-9]+)?([/?]|$)"
                  },
                  {
                    "pattern": "[?&](theme|lang)(=|&|$)"
                  }
                ]
              }
            }
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 40
            }
          ]
        },
        "capabilities": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "send.message",
              "read.messages",
              "read.room",
              "upload.file",
              "download.file"
            ]
          }
        },
        "parameters": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "room_id",
              "user_id",
              "display_name"
            ]
          }
        },
        "events": {
          "description": "Custom room events (never state) the widget may send and read in the one room it is opened in. Reverse DNS names such as com.example.fileshare.sent. Not m, m.*, org.matrix.*, im.vector.* or io.element.*. Send limits: a plain JSON object of at most 8192 characters, no top-level m.relates_to or m.mentions.",
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_-]*(\\.[a-z0-9][a-z0-9_-]*){2,}$",
            "not": {
              "pattern": "^(m|org\\.matrix|im\\.vector|io\\.element)(\\.|$)"
            }
          }
        },
        "fromLinks": {
          "description": "Cards for links on exactly this widget's origin get a button that opens the clicked link (any path) in a window. Needs a linkCards rule for that host. The page at the link runs code.",
          "const": true
        },
        "linkLabel": {
          "description": "Text of that button (default \"Open here\"). Only with fromLinks.",
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 24
            }
          ]
        },
        "saveFiles": {
          "description": "The page may save files to the device (the sandbox gets allow-downloads).",
          "const": true
        }
      },
      "dependencies": {
        "linkLabel": [
          "fromLinks"
        ]
      }
    },
    "field": {
      "description": "A JSON field of the answer, or up to 4 field names joined with \".\" (such as owner.login).",
      "type": "string",
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9_]{1,32}(\\.[A-Za-z0-9_]{1,32}){0,3}$",
      "not": {
        "pattern": "(^|\\.)(__proto__|constructor|prototype)(\\.|$)"
      }
    },
    "linkDetails": {
      "description": "Data only, but it contacts one host: when a card with \"details\" is shown, Mudrix GETs the lookup path on this host (without cookies) and shows the named fields of the JSON answer as plain text. In encrypted rooms only when the person presses the card's button.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "lookups"
      ],
      "properties": {
        "host": {
          "$ref": "#/definitions/host"
        },
        "lookups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/lookup"
          }
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "facts"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$"
        },
        "path": {
          "description": "Starts with \"/\"; letters, digits, . _ ~ / - and {name} placeholders from the card's pathPattern (filled in percent-encoded); no \".\" or \"..\" segments; no query string.",
          "type": "string",
          "maxLength": 200,
          "pattern": "^/([A-Za-z0-9._~/-]|\\{[a-z][a-z0-9_]{0,15}\\})*$",
          "not": {
            "pattern": "(^|/)\\.{1,2}(/|$)"
          }
        },
        "title": {
          "description": "Field shown as the card title.",
          "$ref": "#/definitions/field"
        },
        "description": {
          "description": "Field shown under the title (up to 3 lines).",
          "$ref": "#/definitions/field"
        },
        "descriptionIf": {
          "description": "Id of a toggle setting: the description is shown only while it is on.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
        },
        "facts": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/fact"
          }
        }
      },
      "dependencies": {
        "descriptionIf": [
          "description"
        ]
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "field"
      ],
      "properties": {
        "label": {
          "allOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "maxLength": 24
            }
          ]
        },
        "field": {
          "$ref": "#/definitions/field"
        },
        "format": {
          "description": "text (default), count (12.3K) or date (a localised date from an ISO date string).",
          "enum": [
            "text",
            "count",
            "date"
          ]
        },
        "if": {
          "description": "Id of a toggle setting: the fact is shown only while it is on.",
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
        }
      }
    },
    "setting": {
      "description": "An option the person can change in Settings > Integrations. Values stay on their device and are never sent anywhere by Mudrix; they only fill this integration's own templates or switch looked-up fields on and off. Not for passwords or tokens. Changing a setting's type or default, or adding a choice value, counts as an update that needs approval.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "type",
            "default"
          ],
          "properties": {
            "id": {
              "description": "Starts with a lowercase letter, then letters and digits (up to 24). Used as {setting.<id>} in templates, or in \"if\" / \"descriptionIf\".",
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 40
                }
              ]
            },
            "description": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 120
                }
              ]
            },
            "type": {
              "const": "toggle"
            },
            "default": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "type",
            "default"
          ],
          "properties": {
            "id": {
              "description": "Starts with a lowercase letter, then letters and digits (up to 24). Used as {setting.<id>} in templates, or in \"if\" / \"descriptionIf\".",
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 40
                }
              ]
            },
            "description": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 120
                }
              ]
            },
            "type": {
              "const": "text"
            },
            "default": {
              "type": "string",
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B-\\u200F\\u2028-\\u202E\\u2060-\\u206F\\uFEFF\\uFFF9-\\uFFFB]*$",
              "description": "May be empty. At most maxLength characters."
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "label",
            "type",
            "default",
            "options"
          ],
          "properties": {
            "id": {
              "description": "Starts with a lowercase letter, then letters and digits (up to 24). Used as {setting.<id>} in templates, or in \"if\" / \"descriptionIf\".",
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
            },
            "label": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 40
                }
              ]
            },
            "description": {
              "allOf": [
                {
                  "$ref": "#/definitions/text"
                },
                {
                  "maxLength": 120
                }
              ]
            },
            "type": {
              "const": "choice"
            },
            "default": {
              "type": "string",
              "description": "The value of one of the options."
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
