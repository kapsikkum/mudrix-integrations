{
  "name": "mudrix-integrations",
  "private": true,
  "type": "module",
  "description": "A Mudrix integration repository. Checking and signing tools: no dependencies.",
  "engines": { "node": ">=20" },
  "scripts": {
    "init": "node scripts/sign.mjs init",
    "sign": "node scripts/sign.mjs sign --bump",
    "verify": "node scripts/sign.mjs verify",
    "dev": "node examples/dev-server.mjs",
    "check": "node scripts/validate.mjs && node scripts/sign.mjs verify",
    "check:dev": "node scripts/validate.mjs --dev examples/dev-repo.json"
  }
}
