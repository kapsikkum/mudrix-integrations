{
  "schema": 1,
  "name": "Mudrix integrations",
  "integrations": [
    {
      "id": "altersend",
      "name": "AlterSend",
      "description": "Send files off the record: straight from one device to another, end-to-end encrypted, never stored on your homeserver. Shows AlterSend links as transfer cards and adds send and request buttons to the composer.",
      "version": "1.0.0",
      "permissions": {
        "linkCards": [
          {
            "hosts": ["altersend.example"],
            "pathPrefix": "/",
            "title": "AlterSend transfer",
            "subtitle": "Opens in your browser",
            "buttonLabel": "Open"
          }
        ],
        "composerActions": [
          {
            "id": "send",
            "label": "Send",
            "icon": "send",
            "insert": "https://altersend.example/send?room={room}"
          },
          {
            "id": "request",
            "label": "Request",
            "icon": "download",
            "insert": "https://altersend.example/request?room={room}"
          }
        ]
      }
    }
  ]
}
